{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bota.dev/schemas/app-sdk-release-manifest.json",
  "title": "Bota App SDK release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "sdkVersion",
    "sourceRevision",
    "protocolFixtureDigest",
    "firmwareCompatibility",
    "artifacts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "manifestVersion": { "const": 2 }
        },
        "required": ["manifestVersion"]
      },
      "then": {
        "required": ["sdkFamily"],
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/platformPackagePair"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "manifestVersion": { "enum": [1, 2] },
    "sdkFamily": { "const": "bota-app-sdk" },
    "sdkVersion": { "$ref": "#/$defs/semanticVersion" },
    "sourceRevision": { "$ref": "#/$defs/gitRevision" },
    "protocolFixtureDigest": { "$ref": "#/$defs/sha256" },
    "firmwareCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "baselineRevision"],
      "properties": {
        "minimum": { "$ref": "#/$defs/semanticVersion" },
        "maximum": { "$ref": "#/$defs/semanticVersion" },
        "baselineRevision": { "$ref": "#/$defs/gitRevision" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ecosystem",
          "version",
          "checksumSha256",
          "capabilities"
        ],
        "properties": {
          "platform": {
            "enum": ["apple", "android", "react-native", "flutter", "web", "windows", "electron"]
          },
          "packageIdentifier": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "ecosystem": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/semanticVersion" },
          "checksumSha256": { "$ref": "#/$defs/sha256" },
          "sourceRevision": { "$ref": "#/$defs/gitRevision" },
          "normalizedArchiveSha256": { "$ref": "#/$defs/nonzeroSha256" },
          "generator": { "$ref": "#/$defs/generator" },
          "packageInventory": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/packageInventoryEntry" }
          },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "capabilities": {
                  "type": "array",
                  "contains": { "const": "flutter_sdk" }
                }
              },
              "required": ["capabilities"]
            },
            "then": {
              "required": [
                "platform",
                "packageIdentifier",
                "sourceRevision",
                "normalizedArchiveSha256",
                "generator",
                "packageInventory"
              ],
              "properties": {
                "platform": { "const": "flutter" },
                "packageIdentifier": { "const": "bota_flutter_sdk" }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "platformPackagePair": {
      "type": "object",
      "oneOf": [
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "apple" },
            "packageIdentifier": { "const": "BotaAppleSDK" }
          }
        },
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "android" },
            "packageIdentifier": { "const": "dev.bota:bota-android-sdk" }
          }
        },
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "react-native" },
            "packageIdentifier": { "const": "@bota.dev/react-native-sdk" }
          }
        },
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "flutter" },
            "packageIdentifier": { "const": "bota_flutter_sdk" }
          }
        },
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "web" },
            "packageIdentifier": { "const": "@bota.dev/web-sdk" }
          }
        },
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "windows" },
            "packageIdentifier": { "const": "Bota.WindowsSdk" }
          }
        },
        {
          "required": ["platform", "packageIdentifier"],
          "properties": {
            "platform": { "const": "electron" },
            "packageIdentifier": { "const": "@bota.dev/electron-sdk" }
          }
        }
      ]
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "pigeon" },
        "version": { "const": "28.0.0" }
      }
    },
    "packageInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
