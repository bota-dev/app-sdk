{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bota.dev/schemas/app-sdk-release-manifest.json",
  "title": "Bota App SDK release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "sdkVersion",
    "sourceRevision",
    "protocolFixtureDigest",
    "firmwareCompatibility",
    "artifacts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "manifestVersion": { "const": 2 }
        },
        "required": ["manifestVersion"]
      },
      "then": {
        "required": ["sdkFamily"],
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["platform", "packageIdentifier"]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "manifestVersion": { "enum": [1, 2] },
    "sdkFamily": { "const": "bota-app-sdk" },
    "sdkVersion": { "$ref": "#/$defs/semanticVersion" },
    "sourceRevision": { "$ref": "#/$defs/gitRevision" },
    "protocolFixtureDigest": { "$ref": "#/$defs/sha256" },
    "firmwareCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "baselineRevision"],
      "properties": {
        "minimum": { "$ref": "#/$defs/semanticVersion" },
        "maximum": { "$ref": "#/$defs/semanticVersion" },
        "baselineRevision": { "$ref": "#/$defs/gitRevision" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ecosystem",
          "version",
          "checksumSha256",
          "capabilities"
        ],
        "properties": {
          "platform": {
            "enum": ["apple", "android", "react-native", "flutter", "web", "windows", "electron"]
          },
          "packageIdentifier": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "ecosystem": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/semanticVersion" },
          "checksumSha256": { "$ref": "#/$defs/sha256" },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
