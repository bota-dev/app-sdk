{
  "schemaVersion": 1,
  "protocolRevision": "firmware-8b175a89374c",
  "suite": "provisioning",
  "cases": [
    {
      "name": "provisioning-success-code",
      "operation": "constantByte",
      "constant": "PROVISIONING_SUCCESS",
      "expectedHex": "00"
    },
    {
      "name": "already-paired-code",
      "operation": "constantByte",
      "constant": "PROVISIONING_ALREADY_PAIRED",
      "expectedHex": "04"
    },
    {
      "name": "ble-deprovision-command",
      "operation": "constantByte",
      "constant": "DEVICE_CMD_BLE_DEPROVISION",
      "expectedHex": "05"
    },
    {
      "name": "authenticated-reset-command",
      "operation": "constantByte",
      "constant": "DEVICE_CMD_BLE_FACTORY_RESET",
      "expectedHex": "06"
    },
    {
      "name": "reset-receipt-command",
      "operation": "constantByte",
      "constant": "DEVICE_CMD_BLE_FACTORY_RESET_RESULT_ACK",
      "expectedHex": "0a"
    },
    {
      "name": "wifi-grant-packet",
      "operation": "createWiFiGrantPacket",
      "input": { "grantBlob": "grant.test" },
      "expectedHex": "6772616e742e74657374"
    },
    {
      "name": "wifi-scan-command",
      "operation": "createWiFiScanCommand",
      "expectedHex": "01"
    },
    {
      "name": "wifi-config-expired",
      "operation": "parseWiFiConfigResult",
      "inputHex": "02",
      "expected": { "success": false, "error": "grant_expired" }
    },
    {
      "name": "wifi-credential-packet",
      "operation": "createWiFiCredentialPacket",
      "input": { "ssid": "Bota", "password": "secret" },
      "expectedHex": "04426f746106736563726574"
    },
    {
      "name": "wifi-disconnect-packet",
      "operation": "createWiFiCredentialPacket",
      "input": { "ssid": "", "password": "" },
      "expectedHex": "00"
    },
    {
      "name": "wifi-status-connected",
      "operation": "parseWiFiStatusInfo",
      "inputHex": "025704426f7461",
      "expected": { "status": "connected", "signalStrength": 87, "ssid": "Bota" }
    },
    {
      "name": "wifi-status-short-failed",
      "operation": "parseWiFiStatusInfo",
      "inputHex": "03",
      "expected": { "status": "failed" }
    },
    {
      "name": "wifi-scan-scanning",
      "operation": "parseWiFiScanResult",
      "inputHex": "01",
      "expected": null
    },
    {
      "name": "wifi-scan-done",
      "operation": "parseWiFiScanResult",
      "inputHex": "020204426f746164030547756573743202",
      "expected": {
        "networks": [
          { "ssid": "Bota", "quality": 100, "isCurrent": true, "isOpen": true },
          { "ssid": "Guest", "quality": 50, "isCurrent": false, "isOpen": true }
        ],
        "currentSsid": "Bota"
      }
    },
    {
      "name": "wifi-scan-error",
      "operation": "parseWiFiScanResult",
      "inputHex": "0300",
      "expectedError": "protocol_rejected"
    },
    {
      "name": "pk-d-raw-bytes",
      "operation": "identityBytes",
      "inputHex": "000102030405060708090a0b0c0d0e0f",
      "expectedHex": "000102030405060708090a0b0c0d0e0f",
      "baselineReference": "src/managers/DeviceManager.ts"
    }
  ]
}
