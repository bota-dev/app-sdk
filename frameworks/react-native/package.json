{
  "name": "@bota.dev/react-native-sdk",
  "version": "1.1.0",
  "private": true,
  "description": "React Native facade for the Bota App SDK",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "BotaDeviceSDK.podspec",
    "android/",
    "generated/",
    "ios/",
    "lib/",
    "scripts/bota_device_sdk_spm_workaround.rb",
    "src/"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib generated/build",
    "codegen": "node scripts/verify-codegen.mjs --write",
    "codegen:check": "node scripts/verify-codegen.mjs",
    "license-check": "node ../../scripts/check-licenses.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:apple:integration": "../../tools/react-native/test-apple-adapter.sh",
    "test:apple:lifecycle": "../../tools/apple/build-xcframework.sh && swift test -Xswiftc -strict-concurrency=complete -Xswiftc -warnings-as-errors",
    "test:apple:remote-resolution": "../../tools/react-native/test-apple-adapter.sh remote",
    "test:apple:spm-workaround": "ruby test/apple-spm-workaround.test.rb",
    "typecheck": "tsc --noEmit",
    "verify": "node ../../tools/react-native/verify-package.mjs --workspace-root ../.. --package-root . && npm run codegen:check && npm run typecheck && npm test && npm run license-check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bota-dev/app-sdk.git",
    "directory": "frameworks/react-native"
  },
  "author": "Bota",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-native": ">=0.86.3 <1.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "0.43.0",
    "typescript": "6.0.3"
  },
  "codegenConfig": {
    "name": "BotaDeviceSDKSpec",
    "type": "modules",
    "jsSrcsDir": "./src/specs",
    "android": {
      "javaPackageName": "dev.bota.sdk.reactnative"
    }
  },
  "bota": {
    "nativeModuleName": "BotaDeviceSDK",
    "reactNativeFloor": "0.86.3",
    "android": {
      "compileSdkVersion": 36,
      "coroutinesVersion": "1.10.2",
      "kotlinVersion": "2.1.20",
      "mavenCoordinate": "dev.bota:bota-android-sdk",
      "minSdkVersion": 26,
      "namespace": "dev.bota.sdk.reactnative"
    },
    "apple": {
      "podName": "BotaDeviceSDK",
      "moduleName": "BotaDeviceSDK",
      "deploymentTarget": "15.1",
      "swiftVersion": "6.0",
      "cocoapodsVersion": "1.13.0",
      "packageUrl": "https://github.com/bota-dev/app-sdk.git",
      "packageRequirement": "exactVersion",
      "packageProduct": "BotaAppleSDK",
      "localPackagePathEnvironment": "BOTA_APPLE_SDK_PACKAGE_PATH"
    }
  }
}
