{
  "name": "@bota.dev/app-sdk-workspace",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "baseline:native": "node tools/baseline/verify-native-baselines.mjs",
    "baseline:react-native": "node tools/baseline/compare-react-native.mjs",
    "baseline:react-native:api": "node tools/baseline/react-native-api-contract.mjs verify --contract protocol/baseline/react-native-public-api-0.0.65.json",
    "check": "npm run check:licenses",
    "check:licenses": "node scripts/check-licenses.mjs",
    "flutter:analyze": "tools/flutter/run-flutter.sh analyze frameworks/flutter/bota_flutter_sdk",
    "flutter:generate": "tools/flutter/generate-pigeon.sh",
    "flutter:generate:check": "node tools/flutter/verify-pigeon.mjs",
    "flutter:test": "tools/flutter/run-flutter.sh test frameworks/flutter/bota_flutter_sdk/test",
    "flutter:verify": "node tools/flutter/verify-package.mjs && tools/flutter/run-flutter.sh --version && npm run flutter:analyze && npm run flutter:test",
    "license-check": "npm run check:licenses",
    "react-native:verify": "node tools/react-native/verify-package.mjs",
    "release:channel": "node tools/release/resolve-release-channel.mjs",
    "sync:android-fixtures": "node tools/android/sync-protocol-fixtures.mjs --check",
    "sync:android-workflows": "node tools/android/sync-workflow-fixtures.mjs --check",
    "sync:apple-fixtures": "node tools/apple/sync-protocol-fixtures.mjs --check && node tools/apple/sync-workflow-fixtures.mjs --check",
    "test:android:foundation": "tools/android/test-foundation.sh",
    "test:fixtures": "node --test tools/baseline/*.test.mjs",
    "test:release": "node --test tools/release/*.test.mjs tools/android/*.test.mjs",
    "test:react-native": "node --test tools/react-native/*.test.mjs",
    "test:tooling": "node --test scripts/*.test.mjs tools/baseline/*.test.mjs tools/react-native/*.test.mjs",
    "test:workflows": "node tools/baseline/compare-workflows.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "typescript": "6.0.3"
  }
}
