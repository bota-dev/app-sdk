{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bota.dev/schemas/device-protocol-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolRevision",
    "services",
    "constantGroups",
    "layouts",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolRevision": { "type": "string", "minLength": 1 },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uuid", "characteristics"],
        "properties": {
          "name": { "$ref": "#/$defs/constantName" },
          "uuid": { "$ref": "#/$defs/uuid" },
          "characteristics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "uuid"],
              "properties": {
                "name": { "$ref": "#/$defs/constantName" },
                "uuid": { "$ref": "#/$defs/uuid" },
                "introduced": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "constantGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimumLength", "fields"],
        "properties": {
          "minimumLength": { "type": "integer", "minimum": 0 },
          "fixedLength": { "type": "integer", "minimum": 0 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "offset", "width", "encoding"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "offset": { "type": "integer", "minimum": 0 },
                "width": { "type": "integer", "minimum": 0 },
                "encoding": { "type": "string", "minLength": 1 },
                "optional": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "$defs": {
    "constantName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?:[0-9A-F]{4}|[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12})$"
    }
  }
}
